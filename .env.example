# API origin for a separately hosted frontend. Leave unset in local development
# to use the Vite proxy to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: one-click demo logins on the sign-in page.
# These values are bundled into the public JavaScript, so use throwaway accounts
# that exist only on a synthetic-data demo. Never put real credentials here.
VITE_DEMO_ACCOUNTS=[{"label":"Clinician","email":"clinician@demo.com","password":"demo-password"},{"label":"Auditor","email":"auditor@demo.com","password":"demo-password"}]
